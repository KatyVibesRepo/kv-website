# KV Website -> KV ReservationService environment template
# Do not commit real secrets. KV Website should not contain Stripe secret keys,
# Prisma URLs, admin credentials, or authoritative reservation/payment storage config.

# Canonical base URLs. These are the preferred variables used by the shared resolver.
# Local development keeps the two applications separate:
#   Website: http://localhost:3000
#   KVRS:    http://localhost:3001
NEXT_PUBLIC_KVRS_BASE_URL=http://localhost:3001
KVRS_BASE_URL=http://localhost:3001

# Final Production target after the coordinated KVRS cutover.
# Do NOT apply these values to Website Production until the KVRS Production deployment
# and admin.katyvibes.com have been reviewed and approved.
# NEXT_PUBLIC_KVRS_BASE_URL=https://admin.katyvibes.com
# KVRS_BASE_URL=https://admin.katyvibes.com

# Optional endpoint overrides. Leave these unset unless KVRS intentionally exposes a
# non-default path. If set, they MUST resolve to the same host as the canonical base.
# KVRS_PUBLIC_API_BASE_URL=https://admin.katyvibes.com/api/public
# NEXT_PUBLIC_KVRS_PUBLIC_API_BASE_URL=https://admin.katyvibes.com/api/public
# NEXT_PUBLIC_KVRS_CHECKOUT_URL=https://admin.katyvibes.com/api/checkout
# KVRS_ORDER_LOOKUP_URL=https://admin.katyvibes.com/api/orders/by-session

# Legacy aliases remain readable only for transition compatibility. They never outrank
# the canonical base variables, and conflicting hosts are rejected by the shared resolver.
# Prefer leaving these unset.
# KVRS_URL=
# KVRS_PUBLIC_URL=
# NEXT_PUBLIC_KVRS_URL=
# KVRS_API_URL=
# KVRS_CHECKOUT_URL=
# NEXT_PUBLIC_KVRS_CHECKOUT_API_URL=
# NEXT_PUBLIC_KVRS_ORDER_LOOKUP_URL=
# NEXT_PUBLIC_KVRS_ORDERS_BY_SESSION_URL=
